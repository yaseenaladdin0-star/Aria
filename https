<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ARIA — Adaptive Robotics Intelligence Architecture | Aladdin Corporation</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,300;1,9..144,400&family=DM+Mono:wght@300;400;500&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
:root{
  --cream:#faf8f3;--paper:#f4f1ea;--sand:#e8e3d8;
  --warm-gray:#8a8478;--ink:#1c1917;--ink-light:#3d3a35;
  --teal:#0f7a6b;--teal-light:#e8f4f2;--teal-mid:#1a9980;--teal-pale:#c8e8e3;
  --amber:#c4660a;--amber-light:#fef3e6;--amber-pale:#fde0b8;
  --blue:#1a4f7a;--blue-light:#e8f0f8;
  --border:#ddd9d0;--border-strong:#c4bfb5;
  --shadow:rgba(28,25,23,0.09);
}
body{background:var(--cream);color:var(--ink);font-family:'Instrument Sans',sans-serif;font-size:16px;line-height:1.7;overflow-x:hidden;}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:200;background:rgba(250,248,243,0.96);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 48px;height:64px;}
.nav-logo{font-family:'Fraunces',serif;font-size:20px;font-weight:600;color:var(--ink);text-decoration:none;letter-spacing:-0.3px;display:flex;align-items:center;gap:8px;}
.nav-dot{width:8px;height:8px;border-radius:50%;background:var(--teal-mid);display:inline-block;}
.nav-links{display:flex;gap:2px;list-style:none;align-items:center;}
.nav-links a{color:var(--warm-gray);text-decoration:none;font-size:14px;font-weight:500;padding:7px 13px;border-radius:8px;transition:all .18s;display:block;}
.nav-links a:hover{color:var(--ink);background:var(--paper);}
.nav-cta{background:var(--teal)!important;color:#fff!important;font-weight:600!important;border-radius:8px!important;}
.nav-cta:hover{background:var(--teal-mid)!important;color:#fff!important;}

/* BUTTONS */
.btn-p{background:var(--teal);color:#fff;font-weight:600;padding:14px 26px;border-radius:10px;font-size:15px;text-decoration:none;border:none;cursor:pointer;font-family:'Instrument Sans',sans-serif;transition:all .18s;display:inline-flex;align-items:center;gap:8px;}
.btn-p:hover{background:var(--teal-mid);transform:translateY(-2px);box-shadow:0 6px 20px rgba(15,122,107,.28);}
.btn-s{background:transparent;color:var(--ink);font-weight:500;padding:14px 26px;border-radius:10px;font-size:15px;text-decoration:none;border:1.5px solid var(--border-strong);cursor:pointer;font-family:'Instrument Sans',sans-serif;transition:all .18s;display:inline-flex;align-items:center;gap:8px;}
.btn-s:hover{border-color:var(--teal);color:var(--teal);background:var(--teal-light);}
.btn-w{background:#fff;color:var(--teal);font-weight:600;padding:14px 26px;border-radius:10px;font-size:15px;text-decoration:none;border:none;cursor:pointer;font-family:'Instrument Sans',sans-serif;transition:all .18s;display:inline-flex;align-items:center;gap:8px;}
.btn-w:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.18);}
.btn-wo{background:transparent;color:#fff;font-weight:500;padding:14px 26px;border-radius:10px;font-size:15px;text-decoration:none;border:1.5px solid rgba(255,255,255,.45);cursor:pointer;font-family:'Instrument Sans',sans-serif;transition:all .18s;display:inline-flex;align-items:center;gap:8px;}
.btn-wo:hover{background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.8);}

/* HERO */
.hero{min-height:100vh;display:grid;grid-template-columns:1fr 1fr;align-items:center;padding:100px 48px 80px;gap:60px;position:relative;overflow:hidden;background:linear-gradient(150deg,var(--cream) 0%,var(--paper) 55%,var(--teal-light) 100%);}
.hero-bg-grid{position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(var(--border) 1px,transparent 1px),linear-gradient(90deg,var(--border) 1px,transparent 1px);background-size:48px 48px;mask-image:radial-gradient(ellipse 70% 60% at 70% 40%,rgba(0,0,0,.25) 0%,transparent 75%);z-index:0;}
.hero-left{position:relative;z-index:1;}
.hero-right{position:relative;z-index:1;}
.hero-eyebrow{display:inline-flex;align-items:center;gap:8px;background:var(--teal-light);border:1px solid var(--teal-pale);border-radius:100px;padding:6px 14px;margin-bottom:24px;font-family:'DM Mono',monospace;font-size:11px;color:var(--teal);letter-spacing:.06em;text-transform:uppercase;}
.hero-eyebrow-dot{width:6px;height:6px;border-radius:50%;background:var(--teal-mid);animation:breathe 2.4s ease-in-out infinite;}
@keyframes breathe{0%,100%{transform:scale(1);opacity:1;}50%{transform:scale(.7);opacity:.5;}}
.hero h1{font-family:'Fraunces',serif;font-size:clamp(44px,5.5vw,76px);font-weight:500;line-height:1.05;letter-spacing:-2px;margin-bottom:22px;color:var(--ink);}
.hero h1 em{font-style:italic;color:var(--teal-mid);}
.hero-lead{font-size:17px;color:var(--ink-light);max-width:500px;line-height:1.65;margin-bottom:36px;}
.hero-btns{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:52px;}
.hero-stats{display:flex;gap:36px;flex-wrap:wrap;padding-top:28px;border-top:1px solid var(--border);}
.stat-num{font-family:'Fraunces',serif;font-size:30px;font-weight:600;color:var(--ink);letter-spacing:-1px;line-height:1;margin-bottom:2px;}
.stat-num span{color:var(--teal-mid);}
.stat-label{font-size:12px;color:var(--warm-gray);}

/* Hero right — photo + diagram */
.hero-visual{display:flex;flex-direction:column;gap:16px;}
.hero-photo{width:100%;height:240px;object-fit:cover;border-radius:16px;display:block;}
.hero-diagram-card{background:#fff;border:1px solid var(--border);border-radius:14px;padding:22px;box-shadow:0 8px 32px var(--shadow);}
.diagram-label{font-family:'DM Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--warm-gray);text-transform:uppercase;margin-bottom:12px;}

/* SECTIONS */
section{padding:96px 48px;position:relative;}
.si{max-width:1140px;margin:0 auto;}
.eyebrow{font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.1em;color:var(--teal);text-transform:uppercase;margin-bottom:14px;}
h2{font-family:'Fraunces',serif;font-size:clamp(32px,4vw,50px);font-weight:500;letter-spacing:-1.5px;line-height:1.08;margin-bottom:20px;color:var(--ink);}
h2 em{font-style:italic;color:var(--teal-mid);}
.lead{font-size:17px;color:var(--ink-light);max-width:560px;line-height:1.7;}

/* PROBLEM */
.problem{background:var(--paper);border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
.prob-grid{display:grid;grid-template-columns:1fr 1fr;gap:72px;margin-top:52px;align-items:start;}
.prob-copy p{color:var(--ink-light);font-size:16px;line-height:1.75;margin-bottom:18px;}
.prob-copy strong{color:var(--ink);font-weight:600;}
.pull-quote{font-family:'Fraunces',serif;font-size:22px;font-weight:400;font-style:italic;color:var(--teal-mid);line-height:1.35;border-left:3px solid var(--teal-pale);padding-left:20px;margin:24px 0;}
.prob-cards{display:flex;flex-direction:column;gap:0;}
.pcard{background:#fff;border:1px solid var(--border);overflow:hidden;transition:box-shadow .2s,transform .2s;}
.pcard:first-child{border-radius:14px 14px 0 0;}
.pcard:last-child{border-radius:0 0 14px 14px;}
.pcard:not(:last-child){border-bottom:none;}
.pcard:hover{box-shadow:0 8px 28px var(--shadow);transform:translateY(-2px);border-radius:14px;z-index:2;position:relative;}
.pcard-img{width:100%;height:160px;object-fit:cover;display:block;}
.pcard-body{padding:20px 22px;}
.pcard-tag{font-family:'DM Mono',monospace;font-size:10px;letter-spacing:.07em;text-transform:uppercase;margin-bottom:6px;}
.pcard-tag.amber{color:var(--amber);}
.pcard-tag.blue{color:var(--blue);}
.pcard-tag.teal{color:var(--teal);}
.pcard-title{font-weight:600;font-size:15px;color:var(--ink);margin-bottom:6px;}
.pcard p{font-size:13px;color:var(--warm-gray);line-height:1.6;}

/* SOLUTION */
.solution{background:var(--cream);}
.sol-grid{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center;margin-top:52px;}
.diagram-wrap{background:#fff;border:1px solid var(--border);border-radius:18px;padding:28px;box-shadow:0 10px 40px var(--shadow);}
.comp-cards{display:flex;flex-direction:column;gap:12px;margin-top:32px;}
.comp{background:#fff;border:1px solid var(--border);border-radius:14px;padding:20px 22px;display:flex;gap:14px;align-items:flex-start;transition:all .2s;}
.comp:hover{border-color:var(--teal-pale);box-shadow:0 6px 22px var(--shadow);}
.comp-ico{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.comp-ico.teal{background:var(--teal-light);}
.comp-ico.amber{background:var(--amber-light);}
.comp-ico.blue{background:var(--blue-light);}
.comp h3{font-size:15px;font-weight:600;color:var(--ink);margin-bottom:4px;}
.comp p{font-size:13px;color:var(--warm-gray);line-height:1.6;}
.comp-tag{display:inline-block;font-family:'DM Mono',monospace;font-size:10px;letter-spacing:.06em;padding:3px 8px;border-radius:4px;margin-top:8px;}
.comp-tag.teal{background:var(--teal-light);color:var(--teal);}
.comp-tag.amber{background:var(--amber-light);color:var(--amber);}
.comp-tag.blue{background:var(--blue-light);color:var(--blue);}

/* FEDERATED */
.federated{background:var(--paper);border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
.fed-grid{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center;margin-top:52px;}
.fed-copy p{font-size:16px;color:var(--ink-light);line-height:1.75;margin-bottom:16px;}
.fed-copy strong{color:var(--ink);font-weight:600;}
.fed-stats{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:28px;}
.fed-stat{background:#fff;border:1px solid var(--border);border-radius:12px;padding:16px 18px;}
.fed-num{font-family:'Fraunces',serif;font-size:28px;font-weight:600;color:var(--teal-mid);letter-spacing:-1px;line-height:1;margin-bottom:4px;}
.fed-lbl{font-size:12px;color:var(--warm-gray);}

/* TECH PHOTO STRIP */
.photo-strip{background:var(--ink);padding:0;overflow:hidden;}
.photo-strip-inner{display:grid;grid-template-columns:repeat(4,1fr);height:300px;}
.strip-img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s;filter:brightness(.75) saturate(.9);}
.strip-item{overflow:hidden;position:relative;}
.strip-item:hover .strip-img{transform:scale(1.05);filter:brightness(.9) saturate(1);}
.strip-cap{position:absolute;bottom:0;left:0;right:0;padding:12px 16px;background:linear-gradient(transparent,rgba(0,0,0,.65));font-family:'DM Mono',monospace;font-size:10px;letter-spacing:.07em;color:rgba(255,255,255,.8);text-transform:uppercase;}

/* USE CASES */
.cases{background:var(--cream);}
.cases-intro{display:grid;grid-template-columns:1fr 1fr;gap:72px;margin-bottom:52px;align-items:end;}
.cases-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
.case{background:#fff;border:1px solid var(--border);border-radius:18px;overflow:hidden;transition:all .22s;}
.case:hover{box-shadow:0 16px 48px var(--shadow);transform:translateY(-4px);}
.case-img{width:100%;height:180px;object-fit:cover;display:block;}
.case-body{padding:26px;}
.case-sector{font-family:'DM Mono',monospace;font-size:10px;letter-spacing:.1em;color:var(--teal);text-transform:uppercase;margin-bottom:10px;}
.case h3{font-family:'Fraunces',serif;font-size:20px;font-weight:500;letter-spacing:-.5px;margin-bottom:10px;color:var(--ink);}
.case p{font-size:13px;color:var(--warm-gray);line-height:1.7;}
.case-goal{margin-top:16px;padding-top:16px;border-top:1px solid var(--border);font-size:12px;color:var(--teal);font-family:'DM Mono',monospace;letter-spacing:.03em;}

/* ROADMAP */
.roadmap{background:var(--paper);border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
.road-intro{display:grid;grid-template-columns:1fr 1fr;gap:72px;margin-bottom:48px;align-items:end;}
.phase{display:grid;grid-template-columns:110px 1fr;gap:28px;padding:26px 0;border-bottom:1px solid var(--border);align-items:start;}
.phase:last-child{border-bottom:none;}
.ph-num{font-family:'Fraunces',serif;font-size:42px;font-weight:600;color:var(--teal-pale);letter-spacing:-2px;line-height:1;transition:color .18s;}
.phase:hover .ph-num{color:var(--teal-mid);}
.ph-time{font-family:'DM Mono',monospace;font-size:10px;letter-spacing:.07em;color:var(--warm-gray);text-transform:uppercase;margin-top:4px;}
.phase h3{font-size:17px;font-weight:600;color:var(--ink);margin-bottom:6px;}
.phase p{font-size:14px;color:var(--ink-light);line-height:1.65;max-width:500px;}
.ph-tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}
.ph-tag{font-family:'DM Mono',monospace;font-size:10px;letter-spacing:.05em;padding:4px 10px;border-radius:5px;background:var(--sand);color:var(--warm-gray);text-transform:uppercase;}

/* CONTACT */
.contact{background:var(--cream);}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:start;}
.contact-copy h2{margin-bottom:16px;}
.contact-copy p{font-size:16px;color:var(--ink-light);line-height:1.75;margin-bottom:28px;}
.c-detail{display:flex;gap:14px;align-items:flex-start;margin-bottom:14px;padding:14px 16px;background:var(--paper);border:1px solid var(--border);border-radius:10px;}
.c-bar{width:3px;height:36px;background:var(--teal-pale);border-radius:2px;flex-shrink:0;margin-top:2px;}
.c-title{font-weight:600;font-size:14px;color:var(--ink);line-height:1.3;}
.c-desc{font-size:13px;color:var(--warm-gray);}
.c-location{margin-top:22px;font-family:'DM Mono',monospace;font-size:11px;color:var(--warm-gray);letter-spacing:.03em;line-height:1.8;}

/* FORM */
.form-card{background:#fff;border:1px solid var(--border);border-radius:20px;padding:38px;box-shadow:0 8px 32px var(--shadow);}
.form-title{font-family:'Fraunces',serif;font-size:22px;font-weight:500;letter-spacing:-.5px;margin-bottom:4px;color:var(--ink);}
.form-sub{font-size:14px;color:var(--warm-gray);margin-bottom:26px;}
.fg{margin-bottom:16px;}
.fg label{display:block;font-size:12px;font-weight:600;color:var(--ink-light);margin-bottom:6px;letter-spacing:.01em;}
.fg input,.fg textarea,.fg select{width:100%;background:var(--cream);border:1.5px solid var(--border);border-radius:10px;padding:11px 14px;color:var(--ink);font-family:'Instrument Sans',sans-serif;font-size:15px;outline:none;transition:border-color .18s,box-shadow .18s;resize:none;appearance:none;}
.fg input:focus,.fg textarea:focus,.fg select:focus{border-color:var(--teal-mid);box-shadow:0 0 0 3px rgba(26,153,128,.1);}
.fg input::placeholder,.fg textarea::placeholder{color:var(--border-strong);}
.fg textarea{min-height:110px;line-height:1.6;}
.fg-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.submit-btn{width:100%;background:var(--teal);color:#fff;font-weight:600;padding:14px;border-radius:10px;font-size:15px;border:none;cursor:pointer;font-family:'Instrument Sans',sans-serif;transition:all .18s;margin-top:4px;}
.submit-btn:hover{background:var(--teal-mid);transform:translateY(-1px);box-shadow:0 6px 20px rgba(15,122,107,.3);}
.submit-btn:disabled{opacity:.5;cursor:not-allowed;transform:none;box-shadow:none;}
.form-status{margin-top:14px;padding:12px 16px;border-radius:10px;font-size:14px;display:none;}
.form-status.ok{background:var(--teal-light);border:1px solid var(--teal-pale);color:var(--teal);display:block;}
.form-status.err{background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;display:block;}

/* MODAL */
.modal-bg{position:fixed;inset:0;background:rgba(28,25,23,.65);backdrop-filter:blur(6px);z-index:500;display:none;align-items:center;justify-content:center;padding:24px;}
.modal-bg.on{display:flex;}
.modal{background:#fff;border-radius:22px;padding:42px;max-width:500px;width:100%;position:relative;box-shadow:0 32px 80px rgba(28,25,23,.22);animation:mIn .27s ease;}
@keyframes mIn{from{opacity:0;transform:translateY(12px) scale(.98);}to{opacity:1;transform:none;}}
.modal-x{position:absolute;top:16px;right:16px;background:var(--paper);border:none;color:var(--warm-gray);width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:17px;display:flex;align-items:center;justify-content:center;transition:all .15s;line-height:1;}
.modal-x:hover{background:var(--sand);color:var(--ink);}
.modal-eye{font-family:'DM Mono',monospace;font-size:11px;letter-spacing:.08em;color:var(--teal);text-transform:uppercase;margin-bottom:10px;}
.modal h3{font-family:'Fraunces',serif;font-size:24px;font-weight:500;letter-spacing:-.5px;margin-bottom:6px;color:var(--ink);}
.modal-desc{font-size:14px;color:var(--warm-gray);margin-bottom:24px;line-height:1.6;}

/* CTA BAND */
.cta-band{background:linear-gradient(135deg,#0a6057 0%,var(--teal-mid) 100%);padding:80px 48px;text-align:center;}
.cta-band h2{color:#fff;margin-bottom:16px;}
.cta-band p{color:rgba(255,255,255,.75);font-size:17px;max-width:460px;margin:0 auto 36px;}
.cta-acts{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;}

/* FOOTER */
footer{background:var(--ink);padding:44px 48px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:24px;}
.foot-logo{font-family:'Fraunces',serif;font-size:18px;font-weight:500;color:#fff;}
.foot-logo span{color:var(--teal-mid);}
.foot-links{display:flex;gap:20px;flex-wrap:wrap;}
.foot-links a{font-size:13px;color:rgba(255,255,255,.42);text-decoration:none;transition:color .15s;}
.foot-links a:hover{color:rgba(255,255,255,.8);}
.foot-copy{font-size:12px;color:rgba(255,255,255,.28);font-family:'DM Mono',monospace;}

/* REVEAL */
.rev{opacity:0;transform:translateY(20px);transition:opacity .55s ease,transform .55s ease;}
.rev.on{opacity:1;transform:none;}
</style>
</head>
<body>

<!-- MODAL -->
<div class="modal-bg" id="modal">
  <div class="modal">
    <button class="modal-x" onclick="closeModal()">&#x2715;</button>
    <div class="modal-eye">Get in touch</div>
    <h3>Send us a message</h3>
    <p class="modal-desc">We welcome partners, researchers, investors, and anyone curious about ARIA. We read every message and reply personally.</p>
    <div class="fg"><label>Your name</label><input type="text" id="m-name" placeholder="Jane Smith"></div>
    <div class="fg"><label>Your email</label><input type="email" id="m-email" placeholder="jane@example.com"></div>
    <div class="fg"><label>Message</label><textarea id="m-msg" placeholder="Tell us about your interest in ARIA..."></textarea></div>
    <button class="submit-btn" id="m-btn" onclick="submitModal()">Send message</button>
    <div class="form-status" id="m-status"></div>
  </div>
</div>

<!-- NAV -->
<nav>
  <a href="#top" class="nav-logo"><span class="nav-dot"></span>ARIA</a>
  <ul class="nav-links">
    <li><a href="#problem">Problem</a></li>
    <li><a href="#solution">Solution</a></li>
    <li><a href="#federated">Technology</a></li>
    <li><a href="#cases">Use Cases</a></li>
    <li><a href="#roadmap">Roadmap</a></li>
    <li><a href="#contact">Contact</a></li>
    <li><a href="#contact" class="nav-cta">Get in touch</a></li>
  </ul>
</nav>

<!-- HERO -->
<section class="hero" id="top">
  <div class="hero-bg-grid"></div>
  <div class="hero-left">
    <div class="hero-eyebrow"><span class="hero-eyebrow-dot"></span>Prototype Stage ;; Aladdin Corporation</div>
    <h1>The universal<br>AI brain for<br>;any robot.</em></h1>
    <p class="hero-lead">ARIA is a modular intelligence layer designed to attach to virtually any existing robot and give it autonomous decision-making, environmental awareness, and continuous learning ;; for under $200.</p>
    <div class="hero-btns">
      <a href="#solution" class="btn-p">See how it works &#8595;</a>
      <button class="btn-s" onclick="openModal()">Get in touch &#8599;</button>
    </div>
    <div class="hero-stats">
      <div><div class="stat-num">$<span>200</span></div><div class="stat-label">Target hardware cost</div></div>
      <div><div class="stat-num">&lt;<span>15</span>W</div><div class="stat-label">Power draw target</div></div>
      <div><div class="stat-num"><span>3</span></div><div class="stat-label">Core impact sectors</div></div>
      <div><div class="stat-num"><span>12</span>mo</div><div class="stat-label">Prototype roadmap</div></div>
    </div>
  </div>
  <div class="hero-right">
    <div class="hero-visual">
      <img class="hero-photo" src="https://images.unsplash.com/photo-1509099342178-e323b1717dba?w=800&q=80&auto=format&fit=crop&crop=top" alt="An African woman plants crops with her baby on her back — the daily reality ARIA is built to transform">

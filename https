<script>
// ── CONTACT FORM via Formspree ──────────────────────────────────────
// Formspree works from local HTML files, GitHub Pages, and any host.
// SETUP (2 minutes, free):
// 1. Go to https://formspree.io and sign up with yaseenaladdin0@gmail.com
// 2. Click "New Form", name it "ARIA Contact"
// 3. Copy the form endpoint — it looks like: https://formspree.io/f/xyzabc12
// 4. Paste it below replacing YOUR_FORMSPREE_ENDPOINT
const FORMSPREE = 'https://formspree.io/f/maqvqjjp';

async function sendForm(data, btnId, statusId) {
  const btn = document.getElementById(btnId);
  const box = document.getElementById(statusId);

  if (!data.name || !data.email || !data.message) {
    setStatus(box, 'err', 'Please fill in your name, email, and message.');
    return;
  }
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email)) {
    setStatus(box, 'err', 'Please enter a valid email address.');
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Sending...';
  box.style.display = 'none';

  try {
    const res = await fetch(FORMSPREE, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(data)
    });
    const json = await res.json();
    if (res.ok) {
      setStatus(box, 'ok', "Message sent! We'll be in touch soon.");
      btn.textContent = 'Sent!';
    } else {
      throw new Error(json.error || 'Unknown error');
    }
  } catch (err) {
    console.error(err);
    // Fallback: open mail client so message is never lost
    const sub = encodeURIComponent('ARIA Inquiry from ' + data.name);
    const body = encodeURIComponent(
      'Name: ' + data.name + '\nEmail: ' + data.email +
      '\nOrg: ' + (data.organisation||'N/A') +
      '\nReason: ' + (data.reason||'N/A') +
      '\n\n' + data.message
    );
    window.location.href = 'mailto:yaseenaladdin0@gmail.com?subject=' + sub + '&body=' + body;
    setStatus(box, 'ok', 'Opening your email app to send directly...');
    btn.disabled = false;
    btn.textContent = 'Send message';
  }
}

function setStatus(el, type, msg) {
  el.className = 'form-status ' + type;
  el.textContent = msg;
}

function submitModal() {
  sendForm({
    name:         document.getElementById('m-name').value.trim(),
    email:        document.getElementById('m-email').value.trim(),
    organisation: 'N/A',
    reason:       'General inquiry',
    message:      document.getElementById('m-msg').value.trim(),
  }, 'm-btn', 'm-status');
}

function submitContact() {
  const fn = document.getElementById('c-fn').value.trim();
  const ln = document.getElementById('c-ln').value.trim();
  sendForm({
    name:         [fn,ln].filter(Boolean).join(' ') || 'Not provided',
    email:        document.getElementById('c-em').value.trim(),
    organisation: document.getElementById('c-org').value.trim() || 'N/A',
    reason:       document.getElementById('c-reason').value || 'Not specified',
    message:      document.getElementById('c-msg').value.trim(),
  }, 'c-btn', 'c-status');
}

// ── Modal ──
function openModal() {
  document.getElementById('modal').classList.add('on');
  document.body.style.overflow = 'hidden';
}
function closeModal() {
  document.getElementById('modal').classList.remove('on');
  document.body.style.overflow = '';
}
document.getElementById('modal').addEventListener('click', e => { if(e.target===e.currentTarget) closeModal(); });

// ── Scroll reveal ──
const obs = new IntersectionObserver(entries => {
  entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('on'); });
}, { threshold: 0.08 });
document.querySelectorAll('.rev').forEach((el,i) => {
  el.style.transitionDelay = (i%4 * 0.1)+'s';
  obs.observe(el);
});
</script>
